FROM python:3.13-slim

RUN pip install --no-cache-dir uv

WORKDIR /opt/airflow/project

# The project itself, so `uv run lake-research-map --stage <stage>` (what every
# DAG's BashOperator shells out to, see airflow/dags/lake_research_map_dags.py)
# works from inside the container.
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY main.py ./

# This venv is what `uv run` resolves against for the project's own code --
# kept separate from the host's .venv (its activation scripts embed
# host-specific absolute paths) -- docker-compose.yml sets the same
# UV_PROJECT_ENVIRONMENT and mounts it as a named volume.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv-airflow
RUN uv sync --frozen --no-dev

# Airflow itself lives in a *separate* venv, not this one. apache-airflow-core
# still pins SQLAlchemy 1.4.x; installing it alongside the project's own deps
# would downgrade the shared environment's SQLAlchemy 2.0.53 -> 1.4.x and
# silently break the pipeline's 2.0-style models/queries. Airflow 3.x is
# required regardless -- the DAGs use `airflow.sdk.DAG`/`TaskGroup`, only
# exposed from 3.0 onward.
ARG AIRFLOW_VERSION=3.3.1
ARG AIRFLOW_PYTHON_VERSION=3.13
RUN uv venv /opt/venv-airflow-server && \
    uv pip install --python /opt/venv-airflow-server/bin/python \
      "apache-airflow==${AIRFLOW_VERSION}" \
      apache-airflow-providers-standard \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${AIRFLOW_PYTHON_VERSION}.txt"

ENV PATH="/opt/venv-airflow-server/bin:${PATH}"
ENV AIRFLOW_HOME=/opt/airflow
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2

EXPOSE 8080

ENTRYPOINT ["airflow"]
