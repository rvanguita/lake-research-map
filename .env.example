MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Required only for a live OpenAlex refresh; the API key is optional/premium.
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Crossref polite-pool contact, kept separate from OPENALEX_EMAIL because consent is per
# service. Optional: without it the public pool (5 req/s) is used.
CROSSREF_EMAIL=
# Bound native numerical libraries prevent CPU oversubscription and OOM kills.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
LAKE_RESEARCH_MAP_EMBED_REVISION=52398278842ec682c6f32300af41344b1c0b0bb2
LAKE_RESEARCH_MAP_EMBED_BATCH_SIZE=64
LAKE_RESEARCH_MAP_EMBED_THREADS=2
# Pinned cross-encoder for the experimental `--rerank` (retrieval/models.py); override only to
# move the pin deliberately.
LAKE_RESEARCH_MAP_RERANK_REVISION=a09144355adeed5f58c8ed011d209bf8ee5a1fec
# Optional override when the latest complete bibliographic year differs from current year - 1.
LAKE_RESEARCH_MAP_COMPLETE_YEAR=
LAKE_RESEARCH_MAP_CITATION_OBSERVATION_YEAR=
# Vector store (ADR-08): required by the embed and semantic stages, publication and dense
# search. Start it with `docker compose --profile qdrant up -d qdrant`. Inside docker compose
# the dashboard service overrides this to http://qdrant:6333.
QDRANT_URL=http://127.0.0.1:6333
# Optional. Only needed if the Qdrant server is configured with QDRANT__SERVICE__API_KEY.
QDRANT_API_KEY=
# Uncomment to make a plain `docker compose up -d` start Qdrant too.
# COMPOSE_PROFILES=qdrant
# Persistent fastembed model cache. The default lives under /tmp, which is tmpfs on many
# machines, so every reboot re-downloads the models (~150 MB). Keep the line commented out
# rather than empty: fastembed treats an empty value as the current directory.
# FASTEMBED_CACHE_PATH=/home/<user>/.cache/fastembed
