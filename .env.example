MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Runtime roles fall back to MYSQL_USER/MYSQL_PASSWORD during migration.
MYSQL_PIPELINE_USER=lake_pipeline
MYSQL_PIPELINE_PASSWORD=
MYSQL_DASHBOARD_USER=lake_dashboard
MYSQL_DASHBOARD_PASSWORD=
LAKE_RESEARCH_MAP_DB_ROLE=pipeline
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Bound native numerical libraries prevent CPU oversubscription and OOM kills.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
LAKE_RESEARCH_MAP_EMBED_REVISION=52398278842ec682c6f32300af41344b1c0b0bb2
# Optional override when the latest complete bibliographic year differs from current year - 1.
LAKE_RESEARCH_MAP_COMPLETE_YEAR=
AIRFLOW_BASE_URL=http://localhost:8080
