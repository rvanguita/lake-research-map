MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Required only for a live OpenAlex refresh; the API key is optional/premium.
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Bound native numerical libraries prevent CPU oversubscription and OOM kills.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
LAKE_RESEARCH_MAP_EMBED_REVISION=52398278842ec682c6f32300af41344b1c0b0bb2
LAKE_RESEARCH_MAP_EMBED_BATCH_SIZE=64
LAKE_RESEARCH_MAP_EMBED_THREADS=2
# Optional override when the latest complete bibliographic year differs from current year - 1.
LAKE_RESEARCH_MAP_COMPLETE_YEAR=
LAKE_RESEARCH_MAP_CITATION_OBSERVATION_YEAR=
AIRFLOW_BASE_URL=http://localhost:8080
